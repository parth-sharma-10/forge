# forge-api: the HTTP front door. Unprivileged; nowhere near the sandbox.
# Set FORGE_DSN and FORGE_API_TOKEN in /etc/forge/api.env — without the token
# forge-api refuses to start. Bind to loopback; TLS goes in front.
[Unit]
Description=Forge API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=forge
Group=forge
EnvironmentFile=/etc/forge/api.env
ExecStart=/usr/local/bin/forge-api -listen 127.0.0.1:8080
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
